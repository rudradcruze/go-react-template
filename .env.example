# Copy this file to .env, then set the empty values. Do not commit .env.
# Write each value as plain text, with no quotes, no spaces, and no # or $ characters.
# Then the shell and Docker Compose read the file in the same way.
# The ports come from the port table in .claude/rules/architecture.md.

LOG_LEVEL=info

# Ports on the host
API_PORT=5653
WEB_PORT=5651
ASYNQMON_PORT=5650

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5654
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# Redis (an empty REDIS_PASSWORD means no password)
REDIS_HOST=localhost
REDIS_PORT=5652
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# API docs (Scalar at /docs)
API_DOCS_ENABLED=false
API_DOCS_AUTH_ENABLED=true
API_DOCS_USERNAME=
API_DOCS_PASSWORD=
